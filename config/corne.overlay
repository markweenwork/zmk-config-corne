#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <26>; /* arbitrary; change at will */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    wakeup-source;

    diode-direction = "col2row";
    row-gpios
        = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ; 
    col-gpios
        = <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        , <&pro_micro 16 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        ;
};


/ {
    chosen {
        zmk,underglow = &led_strip;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
    
    default_transform: matrix_transform1 {
    compatible = "zmk,matrix-transform";
    rows = <5>;
    columns = <10>;

    map = <
        RC(0,4) RC(0,3) RC(0,2) RC(0,1)  RC(0,0) RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
        RC(1,4) RC(1,3) RC(1,2) RC(1,1)  RC(1,0) RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
        RC(2,4) RC(2,3) RC(2,2) RC(2,1)  RC(2,0) RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
        RC(3,4) RC(3,3) RC(3,2) RC(3,1)  RC(3,0) RC(3,9) RC(3,8) RC(3,7) RC(3,6) RC(3,5)
        RC(4,4) RC(4,3) RC(4,2) RC(4,1)  RC(4,0) RC(4,9) RC(4,8) RC(4,7) RC(4,6) RC(4,5)
    >;
};
};

&pro_micro_i2c {
    status = "okay";

    oled_128x64: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        inversion-on;
        prechargep = <0x22>;
    };
};
/ {
    chosen {
        zephyr,display = &oled_128x64;
    };
};
